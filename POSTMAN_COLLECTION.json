    {
      "name": "1. TEST CASE POSITIF - CREATE",
      "description": "Positive test cases untuk CREATE inventory",
      "item": [
        {
          "name": "TC1.1 - Create Inventory (Valid Data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response has success true', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "pm.test('Response has data object', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "});",
                  "pm.test('Data has correct fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('code');",
                  "    pm.expect(jsonData.data).to.have.property('name');",
                  "    pm.expect(jsonData.data).to.have.property('quantity');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"INV999\",\n  \"name\": \"Test Item Valid\",\n  \"category\": \"Testing\",\n  \"quantity\": 50,\n  \"unit\": \"pcs\",\n  \"price\": 150000,\n  \"supplier\": \"PT Test Supplier\",\n  \"description\": \"Item untuk testing positif\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/inventories",
              "protocol": "http",
              "host": ["localhost:8000"],
              "path": ["api", "inventories"]
            }
          }
        },
        {
          "name": "TC1.2 - Create Inventory (Minimal Data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
